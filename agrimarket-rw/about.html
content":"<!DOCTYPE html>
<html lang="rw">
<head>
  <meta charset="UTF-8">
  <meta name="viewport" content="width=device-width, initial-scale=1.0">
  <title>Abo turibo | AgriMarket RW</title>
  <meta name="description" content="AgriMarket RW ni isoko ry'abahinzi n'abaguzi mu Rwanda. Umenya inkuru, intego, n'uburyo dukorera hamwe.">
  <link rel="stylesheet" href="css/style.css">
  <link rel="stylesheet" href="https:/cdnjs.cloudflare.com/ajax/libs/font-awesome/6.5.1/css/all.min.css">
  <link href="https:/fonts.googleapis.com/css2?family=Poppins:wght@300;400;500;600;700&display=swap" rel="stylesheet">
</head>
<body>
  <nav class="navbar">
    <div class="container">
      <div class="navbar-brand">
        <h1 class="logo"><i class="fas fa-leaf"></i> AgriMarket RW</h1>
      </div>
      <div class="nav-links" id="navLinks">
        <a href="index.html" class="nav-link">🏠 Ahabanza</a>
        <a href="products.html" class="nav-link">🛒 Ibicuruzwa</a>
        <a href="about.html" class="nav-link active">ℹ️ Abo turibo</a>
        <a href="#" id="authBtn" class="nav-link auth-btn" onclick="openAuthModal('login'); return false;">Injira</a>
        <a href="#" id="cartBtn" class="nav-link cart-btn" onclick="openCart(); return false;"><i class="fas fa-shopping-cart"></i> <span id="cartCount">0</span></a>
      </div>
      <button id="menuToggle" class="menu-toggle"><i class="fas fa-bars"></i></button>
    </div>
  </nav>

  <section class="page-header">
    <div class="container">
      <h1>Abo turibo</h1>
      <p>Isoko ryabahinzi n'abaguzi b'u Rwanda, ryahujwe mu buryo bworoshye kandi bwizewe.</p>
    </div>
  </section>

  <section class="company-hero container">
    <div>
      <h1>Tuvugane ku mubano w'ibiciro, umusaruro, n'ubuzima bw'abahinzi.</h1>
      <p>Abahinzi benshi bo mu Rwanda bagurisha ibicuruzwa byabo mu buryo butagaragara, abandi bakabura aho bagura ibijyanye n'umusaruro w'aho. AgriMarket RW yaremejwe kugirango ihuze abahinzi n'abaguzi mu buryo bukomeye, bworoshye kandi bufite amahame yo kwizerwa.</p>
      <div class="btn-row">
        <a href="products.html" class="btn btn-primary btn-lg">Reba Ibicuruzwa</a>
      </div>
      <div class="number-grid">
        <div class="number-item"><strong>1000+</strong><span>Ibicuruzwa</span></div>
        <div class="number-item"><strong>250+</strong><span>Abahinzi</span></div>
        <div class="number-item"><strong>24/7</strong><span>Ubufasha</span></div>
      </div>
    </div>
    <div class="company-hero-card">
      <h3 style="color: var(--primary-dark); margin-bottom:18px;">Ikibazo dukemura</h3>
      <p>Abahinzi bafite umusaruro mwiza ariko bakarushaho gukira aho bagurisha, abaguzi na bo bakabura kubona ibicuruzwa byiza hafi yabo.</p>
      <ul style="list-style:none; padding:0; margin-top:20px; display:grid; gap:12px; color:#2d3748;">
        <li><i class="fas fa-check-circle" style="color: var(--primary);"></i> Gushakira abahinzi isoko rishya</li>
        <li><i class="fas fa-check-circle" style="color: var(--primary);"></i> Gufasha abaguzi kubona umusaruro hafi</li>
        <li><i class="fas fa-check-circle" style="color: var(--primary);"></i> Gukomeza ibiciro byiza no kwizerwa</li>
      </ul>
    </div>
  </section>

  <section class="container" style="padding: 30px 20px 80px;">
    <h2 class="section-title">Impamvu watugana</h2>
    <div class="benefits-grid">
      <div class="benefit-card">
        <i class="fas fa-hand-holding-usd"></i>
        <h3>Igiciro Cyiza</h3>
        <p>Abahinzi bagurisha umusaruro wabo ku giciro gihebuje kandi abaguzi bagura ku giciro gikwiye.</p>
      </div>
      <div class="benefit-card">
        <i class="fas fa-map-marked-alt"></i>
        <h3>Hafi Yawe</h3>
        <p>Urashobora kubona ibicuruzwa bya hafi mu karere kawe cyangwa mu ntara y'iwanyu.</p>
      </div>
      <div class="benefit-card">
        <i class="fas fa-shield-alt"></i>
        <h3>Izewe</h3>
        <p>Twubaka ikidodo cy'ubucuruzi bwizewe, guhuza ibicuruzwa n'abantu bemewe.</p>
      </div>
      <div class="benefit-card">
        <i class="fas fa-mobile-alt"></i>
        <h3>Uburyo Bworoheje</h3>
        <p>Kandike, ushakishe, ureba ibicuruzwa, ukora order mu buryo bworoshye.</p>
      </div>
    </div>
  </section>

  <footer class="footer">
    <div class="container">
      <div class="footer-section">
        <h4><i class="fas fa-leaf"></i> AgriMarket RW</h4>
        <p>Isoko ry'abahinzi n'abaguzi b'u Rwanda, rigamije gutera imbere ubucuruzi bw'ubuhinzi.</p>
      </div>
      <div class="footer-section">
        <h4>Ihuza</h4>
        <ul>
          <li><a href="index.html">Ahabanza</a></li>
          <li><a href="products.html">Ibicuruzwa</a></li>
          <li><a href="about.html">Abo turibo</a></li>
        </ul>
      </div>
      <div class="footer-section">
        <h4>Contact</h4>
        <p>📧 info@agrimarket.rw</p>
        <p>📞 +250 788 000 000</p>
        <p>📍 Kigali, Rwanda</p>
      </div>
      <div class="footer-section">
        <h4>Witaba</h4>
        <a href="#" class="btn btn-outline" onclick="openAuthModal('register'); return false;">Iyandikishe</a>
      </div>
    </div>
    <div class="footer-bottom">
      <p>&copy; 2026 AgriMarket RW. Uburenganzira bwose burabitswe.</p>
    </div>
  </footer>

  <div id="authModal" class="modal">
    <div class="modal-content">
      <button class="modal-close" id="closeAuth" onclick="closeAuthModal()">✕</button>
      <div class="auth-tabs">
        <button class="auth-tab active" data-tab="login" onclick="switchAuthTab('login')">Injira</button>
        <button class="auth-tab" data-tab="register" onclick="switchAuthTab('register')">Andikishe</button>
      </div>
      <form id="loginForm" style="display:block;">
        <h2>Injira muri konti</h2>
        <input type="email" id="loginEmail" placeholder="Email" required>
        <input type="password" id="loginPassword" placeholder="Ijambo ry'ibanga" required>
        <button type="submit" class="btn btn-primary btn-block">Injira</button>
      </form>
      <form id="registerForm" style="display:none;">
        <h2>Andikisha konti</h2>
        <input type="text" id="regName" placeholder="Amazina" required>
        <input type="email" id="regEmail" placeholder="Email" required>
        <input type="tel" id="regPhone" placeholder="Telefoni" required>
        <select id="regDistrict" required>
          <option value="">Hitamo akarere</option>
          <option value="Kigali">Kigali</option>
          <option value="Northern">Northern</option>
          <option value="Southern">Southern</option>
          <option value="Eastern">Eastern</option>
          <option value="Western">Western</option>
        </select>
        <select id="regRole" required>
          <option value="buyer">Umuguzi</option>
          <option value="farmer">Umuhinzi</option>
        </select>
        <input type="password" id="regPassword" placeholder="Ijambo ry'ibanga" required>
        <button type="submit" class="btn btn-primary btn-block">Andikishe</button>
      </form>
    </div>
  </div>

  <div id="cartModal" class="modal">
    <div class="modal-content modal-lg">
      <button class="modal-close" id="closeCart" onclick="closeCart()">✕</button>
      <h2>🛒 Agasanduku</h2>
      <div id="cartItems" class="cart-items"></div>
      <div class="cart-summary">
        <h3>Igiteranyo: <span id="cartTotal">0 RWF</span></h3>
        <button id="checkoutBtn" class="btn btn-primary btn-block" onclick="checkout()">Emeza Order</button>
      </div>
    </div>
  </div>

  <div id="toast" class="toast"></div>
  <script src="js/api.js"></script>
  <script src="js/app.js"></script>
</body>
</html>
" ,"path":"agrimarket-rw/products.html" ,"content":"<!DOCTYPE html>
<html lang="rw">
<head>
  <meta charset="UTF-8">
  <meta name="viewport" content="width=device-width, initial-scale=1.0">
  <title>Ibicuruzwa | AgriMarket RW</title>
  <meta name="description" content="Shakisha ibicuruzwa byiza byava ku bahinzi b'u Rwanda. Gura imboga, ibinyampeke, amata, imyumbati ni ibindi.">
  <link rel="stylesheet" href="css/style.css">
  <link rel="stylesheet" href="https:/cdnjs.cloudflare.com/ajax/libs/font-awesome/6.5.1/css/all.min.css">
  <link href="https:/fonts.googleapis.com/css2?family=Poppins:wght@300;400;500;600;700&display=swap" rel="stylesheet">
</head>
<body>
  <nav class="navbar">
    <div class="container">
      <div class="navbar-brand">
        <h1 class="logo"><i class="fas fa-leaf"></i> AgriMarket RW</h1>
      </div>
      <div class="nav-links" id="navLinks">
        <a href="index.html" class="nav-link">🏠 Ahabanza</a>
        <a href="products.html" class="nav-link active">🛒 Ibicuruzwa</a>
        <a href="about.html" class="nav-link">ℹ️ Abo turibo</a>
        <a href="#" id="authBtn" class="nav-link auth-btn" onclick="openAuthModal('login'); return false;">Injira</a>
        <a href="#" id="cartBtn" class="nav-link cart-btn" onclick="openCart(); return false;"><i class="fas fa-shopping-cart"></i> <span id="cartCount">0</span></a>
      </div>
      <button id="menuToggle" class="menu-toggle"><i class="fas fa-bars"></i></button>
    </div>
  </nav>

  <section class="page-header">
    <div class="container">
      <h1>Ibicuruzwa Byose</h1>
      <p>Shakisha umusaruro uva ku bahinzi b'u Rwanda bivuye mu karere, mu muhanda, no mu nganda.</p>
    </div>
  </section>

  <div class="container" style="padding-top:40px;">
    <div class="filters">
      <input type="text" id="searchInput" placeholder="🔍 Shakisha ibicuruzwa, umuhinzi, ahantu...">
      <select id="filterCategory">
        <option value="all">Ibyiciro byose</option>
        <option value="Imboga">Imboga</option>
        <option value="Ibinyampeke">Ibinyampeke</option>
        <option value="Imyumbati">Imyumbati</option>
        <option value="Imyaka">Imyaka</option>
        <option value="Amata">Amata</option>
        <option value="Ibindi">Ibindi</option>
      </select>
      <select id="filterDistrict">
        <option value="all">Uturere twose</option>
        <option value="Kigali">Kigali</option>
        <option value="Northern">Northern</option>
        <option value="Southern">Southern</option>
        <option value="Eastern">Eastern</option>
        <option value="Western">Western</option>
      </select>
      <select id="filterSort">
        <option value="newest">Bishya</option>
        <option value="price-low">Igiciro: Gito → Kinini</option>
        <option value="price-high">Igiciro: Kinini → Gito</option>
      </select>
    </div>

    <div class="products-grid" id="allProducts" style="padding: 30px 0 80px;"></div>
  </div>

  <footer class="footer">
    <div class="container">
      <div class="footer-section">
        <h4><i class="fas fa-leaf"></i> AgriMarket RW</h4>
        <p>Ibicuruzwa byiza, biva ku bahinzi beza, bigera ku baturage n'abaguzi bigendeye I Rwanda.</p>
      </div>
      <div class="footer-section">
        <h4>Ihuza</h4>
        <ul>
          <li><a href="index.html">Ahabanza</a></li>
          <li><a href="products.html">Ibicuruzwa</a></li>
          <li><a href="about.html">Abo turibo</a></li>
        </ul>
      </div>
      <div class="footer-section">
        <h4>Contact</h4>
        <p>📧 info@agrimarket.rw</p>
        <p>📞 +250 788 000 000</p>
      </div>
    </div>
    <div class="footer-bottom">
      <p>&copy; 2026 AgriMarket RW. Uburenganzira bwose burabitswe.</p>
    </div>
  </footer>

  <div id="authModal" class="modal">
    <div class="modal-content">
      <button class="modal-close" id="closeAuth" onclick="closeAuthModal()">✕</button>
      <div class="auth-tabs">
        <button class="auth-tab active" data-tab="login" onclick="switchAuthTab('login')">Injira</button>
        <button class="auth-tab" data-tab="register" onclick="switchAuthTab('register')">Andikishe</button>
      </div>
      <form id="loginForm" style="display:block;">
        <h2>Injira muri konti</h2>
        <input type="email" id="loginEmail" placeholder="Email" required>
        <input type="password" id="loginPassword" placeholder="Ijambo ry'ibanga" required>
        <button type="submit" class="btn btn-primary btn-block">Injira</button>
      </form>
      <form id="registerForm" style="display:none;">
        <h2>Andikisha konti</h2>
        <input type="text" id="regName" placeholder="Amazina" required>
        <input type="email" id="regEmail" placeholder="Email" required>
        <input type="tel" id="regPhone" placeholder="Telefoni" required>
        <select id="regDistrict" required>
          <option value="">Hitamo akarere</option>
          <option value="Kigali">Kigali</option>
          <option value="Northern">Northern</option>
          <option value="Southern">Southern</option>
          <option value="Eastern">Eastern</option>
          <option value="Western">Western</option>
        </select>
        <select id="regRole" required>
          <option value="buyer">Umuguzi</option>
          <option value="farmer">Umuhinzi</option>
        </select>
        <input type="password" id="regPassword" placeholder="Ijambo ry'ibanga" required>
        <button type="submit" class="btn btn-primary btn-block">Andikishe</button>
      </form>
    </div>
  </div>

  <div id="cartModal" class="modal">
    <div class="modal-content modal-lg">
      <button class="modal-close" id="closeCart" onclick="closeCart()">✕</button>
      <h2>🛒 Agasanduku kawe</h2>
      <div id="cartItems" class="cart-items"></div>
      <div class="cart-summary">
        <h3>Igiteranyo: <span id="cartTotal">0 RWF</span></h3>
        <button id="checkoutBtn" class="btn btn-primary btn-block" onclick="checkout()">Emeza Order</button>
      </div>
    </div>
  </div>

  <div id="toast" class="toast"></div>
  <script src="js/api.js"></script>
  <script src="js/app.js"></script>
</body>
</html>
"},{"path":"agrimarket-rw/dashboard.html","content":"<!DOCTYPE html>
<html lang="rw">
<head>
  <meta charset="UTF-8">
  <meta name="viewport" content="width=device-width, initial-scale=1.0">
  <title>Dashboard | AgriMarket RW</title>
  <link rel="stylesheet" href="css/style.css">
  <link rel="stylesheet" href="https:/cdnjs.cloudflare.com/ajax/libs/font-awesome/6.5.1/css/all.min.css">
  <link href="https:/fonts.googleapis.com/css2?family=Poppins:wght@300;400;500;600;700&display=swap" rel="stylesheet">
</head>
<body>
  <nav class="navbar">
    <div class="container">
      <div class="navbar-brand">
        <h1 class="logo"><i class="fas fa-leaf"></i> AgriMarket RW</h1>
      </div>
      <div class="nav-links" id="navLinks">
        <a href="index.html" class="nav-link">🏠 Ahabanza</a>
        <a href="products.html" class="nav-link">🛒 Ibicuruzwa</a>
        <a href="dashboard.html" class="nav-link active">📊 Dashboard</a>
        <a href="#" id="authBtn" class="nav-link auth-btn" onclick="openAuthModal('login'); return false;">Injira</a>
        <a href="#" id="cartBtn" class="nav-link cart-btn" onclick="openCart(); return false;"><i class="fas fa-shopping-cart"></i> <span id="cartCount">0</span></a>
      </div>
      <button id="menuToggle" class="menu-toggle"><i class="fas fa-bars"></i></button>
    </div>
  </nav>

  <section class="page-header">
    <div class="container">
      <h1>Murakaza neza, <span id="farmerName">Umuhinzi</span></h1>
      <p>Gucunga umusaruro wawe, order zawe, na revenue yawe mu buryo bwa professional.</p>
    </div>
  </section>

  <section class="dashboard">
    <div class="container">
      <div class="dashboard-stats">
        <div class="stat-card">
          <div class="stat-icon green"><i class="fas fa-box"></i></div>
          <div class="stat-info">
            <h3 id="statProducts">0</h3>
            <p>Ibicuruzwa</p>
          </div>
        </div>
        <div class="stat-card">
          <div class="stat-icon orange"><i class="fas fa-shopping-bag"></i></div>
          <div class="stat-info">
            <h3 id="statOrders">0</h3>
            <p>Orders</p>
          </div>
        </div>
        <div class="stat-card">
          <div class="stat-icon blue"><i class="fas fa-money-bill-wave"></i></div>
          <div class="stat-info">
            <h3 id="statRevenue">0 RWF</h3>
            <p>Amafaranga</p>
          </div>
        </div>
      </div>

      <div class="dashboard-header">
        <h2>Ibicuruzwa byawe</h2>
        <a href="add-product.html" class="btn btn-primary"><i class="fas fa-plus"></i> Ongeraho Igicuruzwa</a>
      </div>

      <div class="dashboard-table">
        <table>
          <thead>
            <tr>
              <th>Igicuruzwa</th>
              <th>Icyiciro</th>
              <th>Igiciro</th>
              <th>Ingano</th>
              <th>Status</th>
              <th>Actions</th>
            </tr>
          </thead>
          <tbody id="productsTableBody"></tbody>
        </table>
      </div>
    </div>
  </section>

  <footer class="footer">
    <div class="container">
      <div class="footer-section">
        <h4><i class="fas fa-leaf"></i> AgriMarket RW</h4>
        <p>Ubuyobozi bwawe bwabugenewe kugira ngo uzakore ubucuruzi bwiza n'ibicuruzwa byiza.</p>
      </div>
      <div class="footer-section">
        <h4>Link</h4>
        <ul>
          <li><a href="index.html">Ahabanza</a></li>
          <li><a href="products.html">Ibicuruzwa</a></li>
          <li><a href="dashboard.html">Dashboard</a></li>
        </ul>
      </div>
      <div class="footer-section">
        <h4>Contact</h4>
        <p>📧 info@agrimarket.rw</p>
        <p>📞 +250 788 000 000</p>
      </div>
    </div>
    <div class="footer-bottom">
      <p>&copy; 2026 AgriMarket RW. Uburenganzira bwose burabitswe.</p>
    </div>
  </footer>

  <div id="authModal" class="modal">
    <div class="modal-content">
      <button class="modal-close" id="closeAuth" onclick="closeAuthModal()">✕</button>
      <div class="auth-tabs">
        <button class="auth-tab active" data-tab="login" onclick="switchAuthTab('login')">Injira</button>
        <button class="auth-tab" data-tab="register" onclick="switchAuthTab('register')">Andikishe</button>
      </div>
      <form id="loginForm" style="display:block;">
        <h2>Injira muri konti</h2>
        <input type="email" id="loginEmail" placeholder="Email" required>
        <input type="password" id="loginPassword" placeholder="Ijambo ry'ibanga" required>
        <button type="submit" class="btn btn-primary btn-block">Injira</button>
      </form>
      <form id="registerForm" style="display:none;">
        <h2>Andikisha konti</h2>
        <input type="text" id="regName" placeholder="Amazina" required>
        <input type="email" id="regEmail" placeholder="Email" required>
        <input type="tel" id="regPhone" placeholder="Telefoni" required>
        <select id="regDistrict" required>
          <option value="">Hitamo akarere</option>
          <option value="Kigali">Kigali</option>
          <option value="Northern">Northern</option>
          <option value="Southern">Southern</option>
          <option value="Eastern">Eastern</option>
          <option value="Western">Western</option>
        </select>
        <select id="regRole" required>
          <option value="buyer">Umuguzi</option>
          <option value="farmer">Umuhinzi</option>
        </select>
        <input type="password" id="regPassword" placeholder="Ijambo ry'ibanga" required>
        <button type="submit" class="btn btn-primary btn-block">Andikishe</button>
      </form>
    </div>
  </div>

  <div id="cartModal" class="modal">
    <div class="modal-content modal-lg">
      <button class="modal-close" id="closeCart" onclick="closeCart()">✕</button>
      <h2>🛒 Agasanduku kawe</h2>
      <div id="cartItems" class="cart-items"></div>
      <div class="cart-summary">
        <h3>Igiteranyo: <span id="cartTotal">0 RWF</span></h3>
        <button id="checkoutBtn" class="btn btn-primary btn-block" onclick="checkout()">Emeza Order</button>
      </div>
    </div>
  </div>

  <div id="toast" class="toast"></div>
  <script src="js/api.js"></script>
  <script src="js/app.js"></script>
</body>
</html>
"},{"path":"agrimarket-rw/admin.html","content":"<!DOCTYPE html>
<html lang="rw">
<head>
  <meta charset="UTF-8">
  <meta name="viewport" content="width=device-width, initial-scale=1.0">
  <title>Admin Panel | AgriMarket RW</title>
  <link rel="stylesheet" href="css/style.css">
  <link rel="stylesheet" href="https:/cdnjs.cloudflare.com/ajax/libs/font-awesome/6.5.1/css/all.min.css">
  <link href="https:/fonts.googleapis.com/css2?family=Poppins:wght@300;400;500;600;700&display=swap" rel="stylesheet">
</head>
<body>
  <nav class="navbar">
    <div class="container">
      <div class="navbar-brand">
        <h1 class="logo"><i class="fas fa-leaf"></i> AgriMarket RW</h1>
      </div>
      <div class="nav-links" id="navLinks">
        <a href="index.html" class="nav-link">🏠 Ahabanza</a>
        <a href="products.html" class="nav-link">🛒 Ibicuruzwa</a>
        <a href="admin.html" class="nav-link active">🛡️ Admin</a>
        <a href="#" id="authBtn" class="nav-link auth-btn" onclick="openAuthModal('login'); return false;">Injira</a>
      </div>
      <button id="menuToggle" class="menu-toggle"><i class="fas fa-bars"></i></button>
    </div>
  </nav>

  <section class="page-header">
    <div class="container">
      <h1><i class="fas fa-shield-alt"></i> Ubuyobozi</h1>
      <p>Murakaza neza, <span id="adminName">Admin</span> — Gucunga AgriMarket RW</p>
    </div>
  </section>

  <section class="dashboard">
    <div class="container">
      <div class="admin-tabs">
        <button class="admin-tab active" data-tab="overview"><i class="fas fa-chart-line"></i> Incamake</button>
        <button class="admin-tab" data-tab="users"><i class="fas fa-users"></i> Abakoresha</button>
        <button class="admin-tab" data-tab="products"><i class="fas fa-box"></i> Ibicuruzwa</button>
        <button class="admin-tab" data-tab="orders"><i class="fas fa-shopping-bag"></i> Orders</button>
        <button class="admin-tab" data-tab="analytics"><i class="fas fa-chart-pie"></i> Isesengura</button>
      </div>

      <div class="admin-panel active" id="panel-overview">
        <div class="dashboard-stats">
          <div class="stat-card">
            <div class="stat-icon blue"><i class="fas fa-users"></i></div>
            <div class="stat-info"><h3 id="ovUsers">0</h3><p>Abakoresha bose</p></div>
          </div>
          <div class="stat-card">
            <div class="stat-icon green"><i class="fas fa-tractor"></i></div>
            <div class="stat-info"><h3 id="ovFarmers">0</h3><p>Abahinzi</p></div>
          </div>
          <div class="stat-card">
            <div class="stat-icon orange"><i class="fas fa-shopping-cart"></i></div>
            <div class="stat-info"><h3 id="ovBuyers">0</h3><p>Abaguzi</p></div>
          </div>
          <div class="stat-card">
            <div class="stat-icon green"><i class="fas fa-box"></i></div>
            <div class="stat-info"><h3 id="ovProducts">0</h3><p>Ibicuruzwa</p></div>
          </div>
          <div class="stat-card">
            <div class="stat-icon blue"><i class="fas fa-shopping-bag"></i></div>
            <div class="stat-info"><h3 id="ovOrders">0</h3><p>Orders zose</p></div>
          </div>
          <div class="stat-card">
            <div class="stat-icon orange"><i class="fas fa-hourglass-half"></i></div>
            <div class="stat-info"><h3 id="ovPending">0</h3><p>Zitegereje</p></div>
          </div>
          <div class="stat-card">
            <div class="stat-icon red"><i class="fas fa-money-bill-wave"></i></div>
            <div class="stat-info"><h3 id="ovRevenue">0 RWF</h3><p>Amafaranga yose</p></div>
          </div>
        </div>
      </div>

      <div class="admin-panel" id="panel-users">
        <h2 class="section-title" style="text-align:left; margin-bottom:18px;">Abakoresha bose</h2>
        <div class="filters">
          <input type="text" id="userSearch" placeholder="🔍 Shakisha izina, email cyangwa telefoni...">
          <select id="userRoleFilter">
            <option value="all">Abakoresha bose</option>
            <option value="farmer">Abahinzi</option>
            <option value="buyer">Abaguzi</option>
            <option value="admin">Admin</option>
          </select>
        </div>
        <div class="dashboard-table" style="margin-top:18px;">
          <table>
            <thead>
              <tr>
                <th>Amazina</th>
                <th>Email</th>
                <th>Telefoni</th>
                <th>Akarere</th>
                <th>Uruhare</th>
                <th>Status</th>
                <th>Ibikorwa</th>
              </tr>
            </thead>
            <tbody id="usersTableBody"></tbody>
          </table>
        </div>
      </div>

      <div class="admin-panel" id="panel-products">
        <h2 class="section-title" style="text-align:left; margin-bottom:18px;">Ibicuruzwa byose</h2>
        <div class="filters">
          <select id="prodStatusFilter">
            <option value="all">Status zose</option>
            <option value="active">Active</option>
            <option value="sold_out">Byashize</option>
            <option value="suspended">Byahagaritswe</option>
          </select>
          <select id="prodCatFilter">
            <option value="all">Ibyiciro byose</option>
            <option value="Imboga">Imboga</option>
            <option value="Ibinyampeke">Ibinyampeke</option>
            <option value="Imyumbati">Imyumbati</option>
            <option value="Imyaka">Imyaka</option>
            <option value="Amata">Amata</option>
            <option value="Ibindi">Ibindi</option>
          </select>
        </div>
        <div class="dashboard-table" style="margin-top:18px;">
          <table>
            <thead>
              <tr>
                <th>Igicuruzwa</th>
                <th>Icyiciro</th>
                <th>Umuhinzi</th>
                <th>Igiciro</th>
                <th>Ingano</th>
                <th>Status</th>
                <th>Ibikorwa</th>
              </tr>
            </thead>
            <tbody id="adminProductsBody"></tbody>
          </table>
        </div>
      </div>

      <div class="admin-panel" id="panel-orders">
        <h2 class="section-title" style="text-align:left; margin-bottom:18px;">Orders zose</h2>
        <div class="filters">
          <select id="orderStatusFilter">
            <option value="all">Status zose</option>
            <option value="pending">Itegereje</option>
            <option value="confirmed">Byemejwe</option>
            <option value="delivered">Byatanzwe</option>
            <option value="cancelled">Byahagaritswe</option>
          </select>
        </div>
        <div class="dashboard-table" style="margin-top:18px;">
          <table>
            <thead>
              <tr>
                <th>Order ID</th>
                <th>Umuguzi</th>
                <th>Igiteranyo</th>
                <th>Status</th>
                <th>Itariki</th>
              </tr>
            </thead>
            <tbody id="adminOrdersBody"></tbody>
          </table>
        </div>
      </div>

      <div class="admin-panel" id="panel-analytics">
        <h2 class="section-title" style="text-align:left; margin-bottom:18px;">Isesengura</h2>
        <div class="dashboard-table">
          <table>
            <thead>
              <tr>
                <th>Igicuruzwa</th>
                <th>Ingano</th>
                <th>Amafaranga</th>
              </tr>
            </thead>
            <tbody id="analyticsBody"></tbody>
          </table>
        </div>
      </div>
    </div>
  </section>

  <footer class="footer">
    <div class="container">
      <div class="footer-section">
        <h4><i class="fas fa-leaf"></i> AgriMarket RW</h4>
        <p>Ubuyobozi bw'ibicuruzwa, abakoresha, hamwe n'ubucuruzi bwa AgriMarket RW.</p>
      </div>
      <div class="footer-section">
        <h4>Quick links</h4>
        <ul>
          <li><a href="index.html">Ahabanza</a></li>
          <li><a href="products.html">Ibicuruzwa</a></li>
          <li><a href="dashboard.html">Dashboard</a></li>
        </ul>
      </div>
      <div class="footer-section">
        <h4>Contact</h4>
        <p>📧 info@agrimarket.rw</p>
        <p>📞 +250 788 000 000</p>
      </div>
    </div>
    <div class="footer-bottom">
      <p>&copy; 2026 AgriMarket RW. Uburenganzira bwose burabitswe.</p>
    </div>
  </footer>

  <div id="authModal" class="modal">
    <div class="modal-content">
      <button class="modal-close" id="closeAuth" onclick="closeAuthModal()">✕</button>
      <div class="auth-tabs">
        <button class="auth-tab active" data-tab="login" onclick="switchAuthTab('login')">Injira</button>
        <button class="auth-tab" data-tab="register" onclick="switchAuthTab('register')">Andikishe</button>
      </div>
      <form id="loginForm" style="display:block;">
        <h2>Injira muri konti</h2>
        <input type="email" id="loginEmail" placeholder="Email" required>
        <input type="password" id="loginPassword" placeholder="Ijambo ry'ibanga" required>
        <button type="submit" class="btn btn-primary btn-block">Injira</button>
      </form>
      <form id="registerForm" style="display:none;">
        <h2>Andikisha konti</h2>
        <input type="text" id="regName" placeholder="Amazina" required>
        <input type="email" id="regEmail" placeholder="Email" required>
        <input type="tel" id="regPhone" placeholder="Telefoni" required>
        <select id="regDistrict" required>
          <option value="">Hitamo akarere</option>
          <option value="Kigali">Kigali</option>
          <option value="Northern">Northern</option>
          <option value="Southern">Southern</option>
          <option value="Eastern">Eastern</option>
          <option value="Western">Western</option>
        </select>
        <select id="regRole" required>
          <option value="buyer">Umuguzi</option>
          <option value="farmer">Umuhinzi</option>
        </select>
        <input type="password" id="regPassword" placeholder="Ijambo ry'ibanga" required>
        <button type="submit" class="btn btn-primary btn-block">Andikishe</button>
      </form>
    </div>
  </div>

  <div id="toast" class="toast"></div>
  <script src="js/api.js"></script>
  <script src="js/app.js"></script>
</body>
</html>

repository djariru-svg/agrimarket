/* Additional professional styles for AgriMarket RW */

.page-header {
  background: linear-gradient(135deg, rgba(39, 174, 96, 0.95), rgba(22, 160, 133, 0.95));
  color: #fff;
  padding: 70px 20px 60px;
  text-align: center;
}

.page-header h1 {
  font-size: clamp(2.2rem, 4vw, 3.6rem);
  margin-bottom: 10px;
}

.page-header p {
  font-size: 1.1rem;
  opacity: 0.95;
}

.section-title {
  font-size: 2.1rem;
  text-align: center;
  margin-bottom: 30px;
  color: var(--dark);
}

.about-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 30px;
  align-items: center;
  padding: 40px 0;
}

.about-text {
  background: #fff;
  border-radius: 18px;
  padding: 32px;
  box-shadow: var(--shadow);
}

.about-text h2 {
  color: var(--primary-dark);
  margin-bottom: 16px;
  font-size: 2rem;
}

.about-text p {
  margin-bottom: 18px;
  color: #4a5568;
  line-height: 1.8;
}

.about-image {
  min-height: 420px;
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.12), rgba(52, 152, 219, 0.18));
  border-radius: 22px;
  display: grid;
  place-items: center;
  font-size: 8rem;
  color: var(--primary);
  box-shadow: var(--shadow-lg);
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
  margin-top: 30px;
}

.benefit-card {
  background: #fff;
  border: 1px solid rgba(39, 174, 96, 0.08);
  border-radius: 18px;
  padding: 28px 20px;
  text-align: center;
  box-shadow: var(--shadow);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.benefit-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.benefit-card i {
  font-size: 2.2rem;
  color: var(--primary);
  margin-bottom: 12px;
}

.benefit-card h3 {
  margin-bottom: 10px;
  color: var(--dark);
}

.benefit-card p {
  color: #4a5568;
  line-height: 1.7;
}

.dashboard {
  padding: 40px 20px 80px;
}

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 28px;
}

.stat-card {
  background: #fff;
  border-radius: 18px;
  padding: 22px 18px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow);
}

.stat-icon {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-size: 1.5rem;
  color: white;
}

.stat-icon.green { background: linear-gradient(135deg, #2ecc71, #27ae60); }
.stat-icon.orange { background: linear-gradient(135deg, #f39c12, #e67e22); }
.stat-icon.blue { background: linear-gradient(135deg, #3498db, #2980b9); }
.stat-icon.red { background: linear-gradient(135deg, #e74c3c, #c0392b); }

.stat-info h3 {
  font-size: 1.7rem;
  margin-bottom: 2px;
}

.stat-info p {
  color: #4a5568;
  font-size: 0.95rem;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30px 0 20px;
}

.dashboard-header h2 {
  font-size: 2rem;
  color: var(--dark);
}

.dashboard-table {
  overflow-x: auto;
  background: #fff;
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.dashboard-table table {
  width: 100%;
  border-collapse: collapse;
}

.dashboard-table th,
.dashboard-table td {
  padding: 15px 16px;
  text-align: left;
  border-bottom: 1px solid #edf0f5;
}

.dashboard-table th {
  background: #f8fafb;
  color: var(--dark);
  font-weight: 700;
}

.dashboard-table td {
  color: #44526a;
}

.filters {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 20px;
}

.filters input,
.filters select {
  width: 100%;
  border: 1px solid #e5e9f2;
  border-radius: 12px;
  padding: 12px 14px;
  background: white;
  font: inherit;
}

.admin-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 18px 0 28px;
}

.admin-tab {
  background: #fff;
  border: 1px solid #e8eef6;
  border-radius: 12px;
  padding: 12px 18px;
  color: var(--dark);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.admin-tab.active,
.admin-tab:hover {
  background: var(--primary);
  color: white;
  box-shadow: var(--shadow);
}

.admin-panel {
  display: none;
}

.admin-panel.active {
  display: block;
}

.badge-status {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
}

.badge-status.active { background: rgba(46, 204, 113, 0.15); color: #16a34a; }
.badge-status.pending { background: rgba(243, 156, 18, 0.15); color: #b45309; }
.badge-status.confirmed { background: rgba(52, 152, 219, 0.15); color: #1d4ed8; }
.badge-status.sold_out { background: rgba(231, 76, 60, 0.15); color: #c0392b; }
.badge-status.cancelled { background: rgba(108, 117, 125, 0.15); color: #4b5563; }

.action-btn {
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 8px 12px;
  margin-right: 8px;
  cursor: pointer;
  font-size: 0.8rem;
}

.action-btn.secondary {
  background: #f59e0b;
}

.action-btn.danger {
  background: #ef4444;
}

.company-hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 30px;
  align-items: center;
  padding: 50px 20px;
}

.company-hero h1 {
  font-size: clamp(2.5rem, 5vw, 4.2rem);
  line-height: 1.1;
  margin-bottom: 18px;
  color: var(--dark);
}

.company-hero p {
  font-size: 1.08rem;
  line-height: 1.8;
  color: #4a5568;
  margin-bottom: 24px;
}

.company-hero-card {
  background: linear-gradient(135deg, #fff, #f3faf4);
  border-radius: 24px;
  padding: 30px;
  box-shadow: var(--shadow-lg);
}

.number-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(100px, 1fr));
  gap: 18px;
  margin-top: 30px;
}

.number-item {
  background: white;
  padding: 20px 16px;
  border-radius: 16px;
  text-align: center;
  box-shadow: var(--shadow);
}

.number-item strong {
  display: block;
  color: var(--primary-dark);
  font-size: 1.8rem;
}

.number-item span {
  color: #4a5568;
}

@media (max-width: 768px) {
  .about-grid,
  .company-hero {
    grid-template-columns: 1fr;
  }

  .dashboard-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .number-grid {
    grid-template-columns: 1fr;
  }
}

